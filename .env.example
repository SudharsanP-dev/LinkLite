# Copy this file to ".env" and fill in your own values.

# --- Server ---
PORT=3000
NODE_ENV=development

# The public address people will see in short links.
# Local:       http://localhost:3000
# Production:  https://your-domain.com   (no trailing slash)
BASE_URL=http://localhost:3000

# --- SQL Server (local, using a SQL login) ---
DB_SERVER=localhost
# Use ONE of the next two lines:
#  a) Named instance such as SQL Server Express (the name after the backslash in SSMS, e.g. localhost\SQLEXPRESS):
DB_INSTANCE=SQLEXPRESS
#  b) Default instance: leave DB_INSTANCE empty and use a port (1433 unless you changed it):
# DB_INSTANCE=
DB_PORT=1433
DB_NAME=linklite
DB_USER=linklite_user
DB_PASSWORD=your_password_here

# Local servers usually don't have a trusted certificate, so this is true for local use.
# For Azure SQL or any server with a real certificate, set DB_ENCRYPT=true and DB_TRUST_CERT=false.
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Authentication
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
# Optional: the first admin is created at startup when both values are set.
# Do not commit the real admin password.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace_with_a_strong_admin_password

# --- Hosted setup (optional) ---
# Some hosts give one connection string instead of separate values.
# If set, it is used and the DB_* values above are ignored.
# DB_CONNECTION_STRING=Server=tcp:yourserver.database.windows.net,1433;Database=linklite;User Id=youruser;Password=yourpassword;Encrypt=true
